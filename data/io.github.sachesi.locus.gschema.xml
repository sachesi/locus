<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="locus">
  <schema id="io.github.sachesi.locus" path="/io/github/sachesi/locus/">
    <key name="update-interval" type="u">
      <range min="1" max="10"/>
      <default>2</default>
      <summary>Seconds between readings</summary>
    </key>
    <key name="show-all-processes" type="b">
      <default>true</default>
      <summary>List the processes of every user</summary>
      <description>When off, only the processes of the user running Locus are listed.</description>
    </key>
    <key name="window-size" type="(ii)">
      <default>(960, 720)</default>
      <summary>Window size</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
  </schema>
</schemalist>
