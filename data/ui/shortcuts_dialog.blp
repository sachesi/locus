using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Resources");
      accelerator: "<Alt>1";
    }

    Adw.ShortcutsItem {
      title: _("File Systems");
      accelerator: "<Alt>2";
    }

    Adw.ShortcutsItem {
      title: _("Processes");
      accelerator: "<Alt>3";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<Control>question";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Control>w";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Control>q";
    }
  }

  Adw.ShortcutsSection {
    title: _("Processes");

    Adw.ShortcutsItem {
      title: _("Search");
      accelerator: "<Control>f";
    }

    Adw.ShortcutsItem {
      title: _("End Process");
      accelerator: "Delete";
    }

    Adw.ShortcutsItem {
      title: _("Kill Process");
      accelerator: "<Shift>Delete";
    }

    Adw.ShortcutsItem {
      title: _("Process Menu");
      accelerator: "Menu <Shift>F10";
    }
  }
}
