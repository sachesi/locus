using Gtk 4.0;
using Adw 1;

template $LocusProcessesPage: Adw.Bin {
  ShortcutController {
    scope: managed;

    Shortcut {
      trigger: "Delete";
      action: "action(process.end)";
    }

    Shortcut {
      trigger: "<Shift>Delete";
      action: "action(process.kill)";
    }

    Shortcut {
      trigger: "Menu|<Shift>F10";
      action: "action(process.menu)";
    }
  }

  child: Box {
    orientation: vertical;

    SearchBar search_bar {
      search-mode-enabled: bind template.search-mode bidirectional;
      key-capture-widget: template;

      child: Adw.Clamp {
        maximum-size: 400;

        child: SearchEntry search_entry {
          placeholder-text: _("Search processes");
          hexpand: true;
          search-changed => $on_search_changed() swapped;
        };
      };
    }

    PopoverBin context_bin {
      vexpand: true;

      popover: PopoverMenu {
        menu-model: process_menu;
        has-arrow: false;
        halign: start;
      };

      child: Box {
        orientation: vertical;

        Box header {
          spacing: 12;
          margin-top: 18;
          margin-bottom: 12;
          margin-start: 18;
          margin-end: 18;

          Box {
            orientation: vertical;
            hexpand: true;
            valign: center;

            Label apps_label {
              xalign: 0;
              wrap: true;

              styles [
                "title-2",
              ]
            }

            Label processes_label {
              xalign: 0;
              wrap: true;

              styles [
                "dim-label",
              ]
            }
          }

          Box {
            valign: center;
            halign: start;

            styles [
              "linked",
            ]

            Button stop_button {
              action-name: "process.stop";

              child: Adw.ButtonContent {
                icon-name: "media-playback-pause-symbolic";
                label: _("_Stop");
                use-underline: true;
              };
            }

            Button continue_button {
              action-name: "process.continue";
              visible: false;

              child: Adw.ButtonContent {
                icon-name: "media-playback-start-symbolic";
                label: _("_Continue");
                use-underline: true;
              };
            }

            Button end_button {
              action-name: "process.end";

              child: Adw.ButtonContent {
                icon-name: "media-playback-stop-symbolic";
                label: _("_End");
                use-underline: true;
              };
            }

            Button kill_button {
              action-name: "process.kill";

              child: Adw.ButtonContent {
                icon-name: "process-stop-symbolic";
                label: _("_Kill");
                use-underline: true;
              };
            }
          }
        }

        Stack stack {
          vexpand: true;
          margin-bottom: 18;
          margin-start: 18;
          margin-end: 18;

          StackPage {
            name: "loading";

            child: Adw.Spinner {
              halign: center;
              valign: center;
              width-request: 32;
              height-request: 32;

              accessibility {
                label: _("Reading processes");
              }
            };
          }

          StackPage {
            name: "list";

            child: ScrolledWindow {
              overflow: hidden;

              styles [
                "card",
              ]

              child: ColumnView view {
                reorderable: false;

                ColumnViewColumn name_column {
                  title: _("Process Name");
                  expand: true;
                  resizable: true;
                }

                ColumnViewColumn user_column {
                  title: _("User");
                  fixed-width: 110;
                  resizable: true;
                  visible: bind template.narrow inverted;
                }

                ColumnViewColumn cpu_column {
                  title: _("CPU");
                  fixed-width: 80;
                }

                ColumnViewColumn memory_column {
                  title: _("Memory");
                  fixed-width: 100;
                }

                ColumnViewColumn disk_column {
                  title: _("Disk");
                  fixed-width: 100;
                  visible: bind template.narrow inverted;
                }

                ColumnViewColumn pid_column {
                  title: _("ID");
                  fixed-width: 80;
                  visible: bind template.narrow inverted;
                }

                styles [
                  "data-table",
                ]
              };
            };
          }

          StackPage {
            name: "empty";

            child: Adw.StatusPage empty_page {
              icon-name: "system-search-symbolic";
              title: _("No Matching Processes");
            };
          }
        }
      };
    }
  };
}

menu process_menu {
  section {
    item {
      label: _("_Stop");
      action: "process.stop";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Continue");
      action: "process.continue";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_End");
      action: "process.end";
    }

    item {
      label: _("_Kill");
      action: "process.kill";
    }
  }
}
