using Gtk 4.0;
using Adw 1;

template $LocusProcessesPage: Adw.Bin {
  ShortcutController {
    scope: managed;

    Shortcut {
      trigger: "Delete";
      action: "action(process.end)";
    }

    Shortcut {
      trigger: "<Shift>Delete";
      action: "action(process.kill)";
    }

    Shortcut {
      trigger: "Menu|<Shift>F10";
      action: "action(process.menu)";
    }
  }

  child: Adw.OverlaySplitView details_split {
    sidebar-position: end;
    collapsed: bind template.compact;
    pin-sidebar: true;
    show-sidebar: bind template.details-shown;
    min-sidebar-width: bind $pane_width(template.narrow) as <float>;
    max-sidebar-width: 400;

    sidebar: $LocusDetailsPane details_pane {};

    content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-end-title-buttons: bind $title_buttons_shown(template.details-shown, template.compact) as <bool>;

      [end]
      ToggleButton {
        icon-name: "sidebar-show-right-symbolic";
        tooltip-text: _("Show Details");
        active: bind template.details-shown bidirectional;
      }

      [start]
      ToggleButton {
        icon-name: "system-search-symbolic";
        tooltip-text: _("Search");
        active: bind template.search-mode bidirectional;
      }

      [start]
      Adw.ToggleGroup arrangement_group {
        active-name: "apps";
        visible: bind template.narrow inverted;
        tooltip-text: _("Arrange Processes");

        Adw.Toggle {
          name: "apps";
          label: _("Apps");
        }

        Adw.Toggle {
          name: "tree";
          label: _("Tree");
        }

        Adw.Toggle {
          name: "all";
          label: _("All");
        }
      }

      title-widget: Adw.WindowTitle title {
        title: _("Processes");
      };
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: bind template.search-mode bidirectional;
      key-capture-widget: template;

      child: Adw.Clamp {
        maximum-size: 400;

        child: SearchEntry search_entry {
          placeholder-text: _("Search processes");
          hexpand: true;
          search-changed => $on_search_changed() swapped;
        };
      };
    }

    [top]
    Adw.WrapBox {
      visible: bind template.narrow;
      child-spacing: 6;
      line-spacing: 6;
      margin-top: 6;
      margin-bottom: 6;
      margin-start: 6;
      margin-end: 6;

      Adw.ToggleGroup narrow_arrangement_group {
        Adw.Toggle {
          name: "apps";
          label: _("Apps");
        }

        Adw.Toggle {
          name: "tree";
          label: _("Tree");
        }

        Adw.Toggle {
          name: "all";
          label: _("All");
        }
      }

      Adw.ToggleGroup metric_group {
        active-name: "cpu";

        Adw.Toggle {
          name: "cpu";
          label: _("CPU");
        }

        Adw.Toggle {
          name: "memory";
          label: _("Memory");
        }

        Adw.Toggle gpu_toggle {
          name: "gpu";
          label: _("GPU");
        }
      }
    }

    content: PopoverBin context_bin {
      vexpand: true;

      popover: PopoverMenu {
        menu-model: process_menu;
        has-arrow: false;
        halign: start;
      };

      child: Stack stack {
        vexpand: true;

        StackPage {
          name: "loading";

          child: Adw.Spinner {
            halign: center;
            valign: center;
            width-request: 32;
            height-request: 32;

            accessibility {
              label: _("Reading processes");
            }
          };
        }

        StackPage {
          name: "list";

          child: ScrolledWindow {
            child: ColumnView view {
              reorderable: false;

              styles [
                "processes",
              ]

              ColumnViewColumn name_column {
                title: _("Name");
                expand: true;
                resizable: true;
              }

              ColumnViewColumn user_column {
                title: _("User");
                fixed-width: 110;
                resizable: true;
                visible: bind $roomy(template.compact, template.details-shown) as <bool>;
              }

              ColumnViewColumn cpu_column {
                title: _("CPU");
                fixed-width: 80;
              }

              ColumnViewColumn memory_column {
                title: _("Memory");
                fixed-width: 100;
              }

              ColumnViewColumn disk_column {
                title: _("Disk");
                fixed-width: 100;
                visible: bind template.narrow inverted;
              }

              ColumnViewColumn gpu_column {
                title: _("GPU");
                fixed-width: 80;
                visible: false;
              }

              ColumnViewColumn pid_column {
                title: _("ID");
                fixed-width: 80;
                visible: bind $roomy(template.compact, template.details-shown) as <bool>;
              }
            };
          };
        }

        StackPage {
          name: "empty";

          child: Adw.StatusPage empty_page {
            icon-name: "system-search-symbolic";
            title: _("No Matching Processes");
          };
        }
      };
    };

    [bottom]
    ActionBar {
      [start]
      Button stop_button {
        label: _("_Stop");
        use-underline: true;
        action-name: "process.stop";
      }

      [start]
      Button continue_button {
        label: _("_Continue");
        use-underline: true;
        action-name: "process.continue";
        visible: false;
      }

      [end]
      Button kill_button {
        label: _("_Kill");
        use-underline: true;
        action-name: "process.kill";

        styles [
          "destructive-action",
        ]
      }

      [end]
      Button end_button {
        label: _("_End");
        use-underline: true;
        action-name: "process.end";
      }
    }
  };
  };
}

menu process_menu {
  section {
    item {
      label: _("_Stop");
      action: "process.stop";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Continue");
      action: "process.continue";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_End");
      action: "process.end";
    }

    item {
      label: _("_Kill");
      action: "process.kill";
    }
  }
}
