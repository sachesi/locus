using Gtk 4.0;
using Adw 1;

template $LocusProcessesPage: Adw.Bin {
  ShortcutController {
    scope: managed;

    Shortcut {
      trigger: "Delete";
      action: "action(process.end)";
    }

    Shortcut {
      trigger: "<Shift>Delete";
      action: "action(process.kill)";
    }

    Shortcut {
      trigger: "Menu|<Shift>F10";
      action: "action(process.menu)";
    }
  }

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      ToggleButton {
        icon-name: "system-search-symbolic";
        tooltip-text: _("Search");
        active: bind template.search-mode bidirectional;
      }

      title-widget: Adw.WindowTitle title {
        title: _("Processes");
      };
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: bind template.search-mode bidirectional;
      key-capture-widget: template;

      child: Adw.Clamp {
        maximum-size: 400;

        child: SearchEntry search_entry {
          placeholder-text: _("Search processes");
          hexpand: true;
          search-changed => $on_search_changed() swapped;
        };
      };
    }

    content: PopoverBin context_bin {
      vexpand: true;

      popover: PopoverMenu {
        menu-model: process_menu;
        has-arrow: false;
        halign: start;
      };

      child: Stack stack {
        vexpand: true;

        StackPage {
          name: "loading";

          child: Adw.Spinner {
            halign: center;
            valign: center;
            width-request: 32;
            height-request: 32;

            accessibility {
              label: _("Reading processes");
            }
          };
        }

        StackPage {
          name: "list";

          child: ScrolledWindow {
            child: ColumnView view {
              reorderable: false;

              styles [
                "processes",
              ]

              ColumnViewColumn name_column {
                title: _("Name");
                expand: true;
                resizable: true;
              }

              ColumnViewColumn user_column {
                title: _("User");
                fixed-width: 110;
                resizable: true;
                visible: bind template.compact inverted;
              }

              ColumnViewColumn cpu_column {
                title: _("CPU");
                fixed-width: 80;
              }

              ColumnViewColumn memory_column {
                title: _("Memory");
                fixed-width: 100;
              }

              ColumnViewColumn disk_column {
                title: _("Disk");
                fixed-width: 100;
                visible: bind template.narrow inverted;
              }

              ColumnViewColumn gpu_column {
                title: _("GPU");
                fixed-width: 80;
                visible: false;
              }

              ColumnViewColumn pid_column {
                title: _("ID");
                fixed-width: 80;
                visible: bind template.narrow inverted;
              }
            };
          };
        }

        StackPage {
          name: "empty";

          child: Adw.StatusPage empty_page {
            icon-name: "system-search-symbolic";
            title: _("No Matching Processes");
          };
        }
      };
    };

    [bottom]
    ActionBar {
      [start]
      Button stop_button {
        label: _("_Stop");
        use-underline: true;
        action-name: "process.stop";
      }

      [start]
      Button continue_button {
        label: _("_Continue");
        use-underline: true;
        action-name: "process.continue";
        visible: false;
      }

      [end]
      Button kill_button {
        label: _("_Kill");
        use-underline: true;
        action-name: "process.kill";

        styles [
          "destructive-action",
        ]
      }

      [end]
      Button end_button {
        label: _("_End");
        use-underline: true;
        action-name: "process.end";
      }
    }
  };
}

menu process_menu {
  section {
    item {
      label: _("_Stop");
      action: "process.stop";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Continue");
      action: "process.continue";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_End");
      action: "process.end";
    }

    item {
      label: _("_Kill");
      action: "process.kill";
    }
  }
}
