using Gtk 4.0;
using Adw 1;

template $LocusWindow: Adw.ApplicationWindow {
  title: "Locus";
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 860sp")

    setters {
      resources_page.compact: true;
    }
  }

  // The last breakpoint that matches is the one applied.
  Adw.Breakpoint {
    condition ("max-width: 550sp")

    setters {
      header_bar.title-widget: null;
      switcher_bar.reveal: true;
      processes_page.narrow: true;
      resources_page.compact: true;
    }
  }

  content: Adw.ToastOverlay toasts {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar header_bar {
        [start]
        ToggleButton {
          icon-name: "system-search-symbolic";
          tooltip-text: _("Search");
          active: bind processes_page.search-mode bidirectional;
          visible: bind $is_processes(stack.visible-child-name) as <bool>;
        }

        title-widget: Adw.ViewSwitcher {
          stack: stack;
          policy: wide;
        };

        [end]
        MenuButton {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          primary: true;
          menu-model: primary_menu;
        }
      }

      content: Adw.ViewStack stack {
        Adw.ViewStackPage {
          name: "resources";
          title: _("Resources");
          icon-name: "resources-symbolic";

          child: $LocusResourcesPage resources_page {};
        }

        Adw.ViewStackPage {
          name: "filesystems";
          title: _("File Systems");
          icon-name: "drive-harddisk-symbolic";

          child: $LocusFileSystemsPage filesystems_page {};
        }

        Adw.ViewStackPage {
          name: "processes";
          title: _("Processes");
          icon-name: "view-list-symbolic";

          child: $LocusProcessesPage processes_page {};
        }
      };

      [bottom]
      Adw.ViewSwitcherBar switcher_bar {
        stack: stack;
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("Show _All Processes");
      action: "win.show-all-processes";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Locus");
      action: "app.about";
    }
  }
}
