using Gtk 4.0;
using Adw 1;

template $LocusWindow: Adw.ApplicationWindow {
  title: "Locus";
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 1100sp")

    setters {
      processes_page.compact: true;
      services_page.compact: true;
    }
  }

  // The last breakpoint that matches is the one applied.
  Adw.Breakpoint {
    condition ("max-width: 720sp")

    setters {
      split_view.collapsed: true;
      processes_page.compact: true;
      services_page.compact: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 550sp")

    setters {
      split_view.collapsed: true;
      processes_page.compact: true;
      services_page.compact: true;
      template.narrow: true;
      processes_page.narrow: true;
      services_page.narrow: true;
    }
  }

  content: Adw.ToastOverlay toasts {
    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 250;
      max-sidebar-width: 290;
      show-content: true;

      sidebar: Adw.NavigationPage {
        title: "Locus";
        tag: "sidebar";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            title-widget: Adw.WindowTitle {
              title: "Locus";
            };

            [end]
            MenuButton {
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              primary: true;
              menu-model: primary_menu;
            }
          }

          content: ScrolledWindow {
            hscrollbar-policy: never;

            child: ListBox sidebar {
              row-activated => $on_row_activated() swapped;

              styles [
                "navigation-sidebar",
              ]
            };
          };
        };
      };

      content: Adw.NavigationPage content_page {
        title: _("Processes");
        tag: "content";

        child: Stack stack {
          hhomogeneous: false;
          vhomogeneous: false;
          opacity: 0;

          StackPage {
            name: "processes";

            child: $LocusProcessesPage processes_page {};
          }

          StackPage {
            name: "services";

            child: $LocusServicesPage services_page {};
          }

          StackPage {
            name: "startup";

            child: $LocusStartupPage startup_page {};
          }

          StackPage {
            name: "cpu";

            child: $LocusCpuPage cpu_page {};
          }

          StackPage {
            name: "memory";

            child: $LocusMemoryPage memory_page {};
          }
        };
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("Show _All Processes");
      action: "win.show-all-processes";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Locus");
      action: "app.about";
    }
  }
}
