using Gtk 4.0;
using Adw 1;

template $LocusFileSystemsPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 960;
      tightening-threshold: 600;

      child: ListBox filesystems {
        selection-mode: none;
        valign: start;
        margin-top: 18;
        margin-bottom: 18;
        margin-start: 12;
        margin-end: 12;

        styles [
          "boxed-list",
        ]
      };
    };
  };
}
